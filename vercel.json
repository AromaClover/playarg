    { "source": "/api/admin/announcements", "destination": "/api/admin?path=announcements" },
    { "source": "/api/admin/problems", "destination": "/api/admin?path=problems" },
    { "source": "/api/admin/set-role", "destination": "/api/admin?path=set-role" },
    { "source": "/api/admin/set-admin-badge", "destination": "/api/admin?path=set-admin-badge" },
    { "source": "/api/admin/contests", "destination": "/api/admin?path=contests" },
    { "source": "/api/admin/banner", "destination": "/api/admin?path=banner" },
    { "source": "/api/admin/sponsors", "destination": "/api/admin?path=sponsors" },
    { "source": "/api/admin/set-status", "destination": "/api/admin?path=set-status" },
    { "source": "/api/admin/discussions", "destination": "/api/admin?path=discussions" },
    { "source": "/api/admin/feed", "destination": "/api/admin?path=feed" },
    { "source": "/api/admin/users", "destination": "/api/admin?path=users" },
    { "source": "/api/admin/batch-delete-problems", "destination": "/api/admin?path=batch-delete-problems" },
    { "source": "/api/admin/batch-set-status", "destination": "/api/admin?path=batch-set-status" },
    { "source": "/api/admin/batch-set-role", "destination": "/api/admin?path=batch-set-role" },
    { "source": "/api/admin/fix-uids", "destination": "/api/admin?path=fix-uids" },
    { "source": "/api/problems", "destination": "/api/data?type=problems" },
    { "source": "/api/announcements", "destination": "/api/data?type=announcements" },
    { "source": "/api/banner", "destination": "/api/data?type=banner" },
    { "source": "/api/sponsors", "destination": "/api/data?type=sponsors" },
    { "source": "/api/feed", "destination": "/api/data?type=feed" },
    { "source": "/api/discussions", "destination": "/api/data?type=discussions" },
    { "source": "/api/notifications", "destination": "/api/data?type=notifications" },
    { "source": "/api/messages", "destination": "/api/data?type=messages" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/problem/:id", "destination": "/problem-detail?id=:id" },
    { "source": "/contest/:id", "destination": "/contest-detail?id=:id" },
    { "source": "/user/:uid", "destination": "/user-profile?uid=:uid" },
    { "source": "/discussions", "destination": "/discussion" },
    { "source": "/discussion/:id", "destination": "/discussion-detail?id=:id" }
  ]
